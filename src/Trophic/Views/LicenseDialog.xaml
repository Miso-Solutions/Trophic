<Window x:Class="Trophic.Views.LicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License"
        Height="430" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        AutomationProperties.Name="License Activation">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{StaticResource MenuBarBrush}">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/app.ico" Width="16" Height="16" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="License" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource DialogCloseButton}" HorizontalAlignment="Right" Margin="0,3,4,3"
                    Click="CloseButton_Click" AutomationProperties.Name="Close">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Current status -->
            <Border Grid.Row="0" Background="{StaticResource MenuBarBrush}" CornerRadius="4"
                    Padding="12,10" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Status" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="StatusDetail" FontSize="11" Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1" Text="License key" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
            <TextBox x:Name="KeyBox" Grid.Row="2" Padding="6,5" FontSize="13"
                     FontFamily="Consolas, Courier New"
                     CharacterCasing="Upper"
                     AutomationProperties.Name="License key"/>
            <TextBlock Grid.Row="3" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                       Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Format: TROPHIC-XXXX-XXXX-XXXX-XXXX. Activation binds the key to this computer."/>

            <TextBlock x:Name="MessageText" Grid.Row="4" FontSize="11" Margin="0,12,0,0"
                       VerticalAlignment="Top" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="DeactivateButton" Content="Deactivate" Width="90" Margin="0,0,10,0"
                        Click="DeactivateButton_Click" Visibility="Collapsed"
                        Style="{StaticResource DialogSecondaryButton}"
                        AutomationProperties.Name="Deactivate this device"/>
                <Button x:Name="ActivateButton" Content="Activate" Width="90" Margin="0,0,10,0"
                        Click="ActivateButton_Click" IsDefault="True"
                        Style="{StaticResource DialogPrimaryButton}"
                        AutomationProperties.Name="Activate license"/>
                <Button Content="Close" Width="80" Click="CloseButton_Click" IsCancel="True"
                        Style="{StaticResource DialogSecondaryButton}"
                        AutomationProperties.Name="Close"/>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
