<Window x:Class="Trophic.Views.ConsoleKeysDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Console Keys"
        Height="470" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        AutomationProperties.Name="Console Keys Settings">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{StaticResource MenuBarBrush}">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Resources/app.ico" Width="16" Height="16" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Console Keys" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Style="{StaticResource DialogCloseButton}" HorizontalAlignment="Right" Margin="0,3,4,3"
                    Click="CancelButton_Click" AutomationProperties.Name="Close">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="20,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="One-time setup. These values identify your PS3 console and PSN account, and are required so resigned saves are accepted by PSN. Stored in console-keys.json next to the application."/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Auto-fill from save folder..." Padding="8,3"
                            Click="FillFromSaveFolderButton_Click"
                            Style="{StaticResource DialogSecondaryButton}"
                            AutomationProperties.Name="Auto-fill from a save folder"/>
                    <TextBlock FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Text="Extracts Authentication ID and User ID. IDPS must still be entered manually."/>
                </StackPanel>
            </StackPanel>

            <!-- Console ID (IDPS) -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Console ID (IDPS)" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="16 bytes / 32 hex" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>
                <TextBox x:Name="IdpsBox" Grid.Column="1" Padding="6,4" FontSize="12"
                         FontFamily="Consolas, Courier New" Margin="6,0,6,0"
                         AutomationProperties.Name="Console IDPS hex"/>
                <Button Grid.Column="2" Content="Browse..." Width="80" Padding="6,3" Click="BrowseIdpsButton_Click"
                        Style="{StaticResource DialogSecondaryButton}"
                        AutomationProperties.Name="Browse for IDPS file"/>
            </Grid>

            <!-- User ID -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="User ID" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="decimal (default 1)" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>
                <TextBox x:Name="UserIdBox" Grid.Column="1" Padding="6,4" FontSize="12"
                         FontFamily="Consolas, Courier New" Margin="6,0,6,0"
                         AutomationProperties.Name="PS3 user ID decimal"/>
                <Button Grid.Column="2" Content="" Width="80" IsEnabled="False"
                        Style="{StaticResource DialogSecondaryButton}"/>
            </Grid>

            <!-- Authentication ID -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Authentication ID" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="8 bytes / 16 hex (from act.dat)" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>
                <TextBox x:Name="AuthIdBox" Grid.Column="1" Padding="6,4" FontSize="12"
                         FontFamily="Consolas, Courier New" Margin="6,0,6,0"
                         AutomationProperties.Name="Authentication ID hex"/>
                <Button Grid.Column="2" Content="Browse..." Width="80" Padding="6,3" Click="BrowseActDatButton_Click"
                        Style="{StaticResource DialogSecondaryButton}"
                        AutomationProperties.Name="Browse for act.dat"/>
            </Grid>

            <TextBlock x:Name="ErrorText" Grid.Row="4" FontSize="11"
                       Foreground="{StaticResource DestructiveBrush}"
                       Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Clear" Width="80" Margin="0,0,10,0" Click="ClearButton_Click"
                        Style="{StaticResource DialogSecondaryButton}"
                        AutomationProperties.Name="Clear stored keys"/>
                <Button Content="Save" Width="80" Margin="0,0,10,0" Click="SaveButton_Click" IsDefault="True"
                        Style="{StaticResource DialogPrimaryButton}"
                        AutomationProperties.Name="Save console keys"/>
                <Button Content="Cancel" Width="80" Click="CancelButton_Click" IsCancel="True"
                        Style="{StaticResource DialogSecondaryButton}"
                        AutomationProperties.Name="Cancel"/>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
