# Copy to .env (or set in your host's environment). Never commit real values.

# Fine-grained, READ-ONLY PAT scoped to the catalog repo's contents.
# Rotate the old client-embedded token before going live.
GITHUB_TOKEN=github_pat_xxx

# Optional overrides:
# PORT=8787
# LICENSE_DB=./data/licenses.db
# TROPHIC_REPO_API=https://api.github.com/repos/Miso-Solutions/Miso-PS3-Database
